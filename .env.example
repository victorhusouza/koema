# Legacy OAuth settings; the current interface uses iCal and does not require these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback

# Optional local encryption key settings for iCal and OAuth connection data.
# GOOGLE_TOKEN_KEY_FILE=
# GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional SQLite database location. Defaults to data/painel.sqlite in the project.
# PAINEL_DB_PATH=

# Required for production browser-mutation Origin checks behind HTTPS termination.
# Must be the canonical HTTPS origin only (no path), for example:
# KOEMA_PUBLIC_ORIGIN=https://koema.souzareis.me

# Set to 1 only when Nginx overwrites X-Real-IP with $remote_addr.
# Otherwise login attempts share one global limiter key.
# KOEMA_TRUST_PROXY=1
